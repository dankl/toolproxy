UPSTREAM_URL=http://<LITELLM_HOST>:4000/v1
UPSTREAM_MODEL=openai/gpt-oss-120b
UPSTREAM_API_KEY=<LITELLM_MASTER_KEY>
LOG_LEVEL=INFO

# Pre-request content filter to avoid OCI safety filter blocks
# Modes: detect (log+warn, default), sanitize (auto-replace), block (return 400 before upstream)
# CONTENT_FILTER_MODE=detect
# Custom JSON array of patterns (optional, empty = built-in defaults):
# CONTENT_FILTER_PATTERNS=[{"pattern":"(?i)\bhack\b","replacement":"","reason":"Hacking"}]
